    "right": { "category": "layout", "status": "partial", "description": "Sets a right position offset.", "values": "<length-percentage> | auto" },
    "bottom": { "category": "layout", "status": "partial", "description": "Sets a bottom position offset.", "values": "<length-percentage> | auto" },
    "left": { "category": "layout", "status": "partial", "description": "Sets a left position offset.", "values": "<length-percentage> | auto" },
    "width": { "category": "layout", "status": "supported", "description": "Sets component width.", "values": "<length-percentage> | auto" },
    "height": { "category": "layout", "status": "supported", "description": "Sets component height.", "values": "<length-percentage> | auto" },
