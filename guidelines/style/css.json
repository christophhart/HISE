    "margin-top": { "category": "layout", "status": "partial", "description": "Sets the top paint inset.", "values": "<length-percentage> | auto" },
    "margin-right": { "category": "layout", "status": "partial", "description": "Sets the right paint inset.", "values": "<length-percentage> | auto" },
    "margin-bottom": { "category": "layout", "status": "partial", "description": "Sets the bottom paint inset.", "values": "<length-percentage> | auto" },
