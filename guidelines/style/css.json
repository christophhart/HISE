    "flex-wrap": { "category": "flex", "status": "supported", "description": "Controls flex-line wrapping.", "values": { "nowrap": "Keep one line.", "wrap": "Wrap in normal direction.", "wrap-reverse": "Wrap in reverse cross direction." } },
