{
  "schemaVersion": "1.0",
  "datasetVersion": "1.0.0",
  "title": "HISE simple_css reference",
  "language": {
    "caseSensitive": true,
    "canonicalCase": "lowercase",
    "finalSemicolonRequired": false,
    "importantSyntax": "value !important as the final separate token",
    "description": "CSS-like styling for JUCE components, not a browser CSS implementation."
  },
  "supportStatuses": {
    "supported": "Parsed, stored, and consumed with the documented behavior.",
    "partial": "Consumed, but semantics or grammar differ from browser CSS.",
    "recognized-only": "Recognized or stored, but no useful general rendering or layout effect exists.",
    "rejected": "Rejected with a diagnostic.",
    "unsupported": "Not a supported syntax form."
  },
  "valueTypes": {
    "number": { "syntax": "[+-]?decimal", "description": "A finite numeric value." },
    "integer": { "syntax": "[+-]?digits", "description": "An integer value." },
    "length": { "syntax": "number | numberpx | numberem | numberrem | numbervh", "description": "A HISE numeric length; bare numbers are accepted." },
    "length-percentage": { "syntax": "length | number%", "description": "A length or percentage resolved against a local rectangle axis." },
    "angle": { "syntax": "numberdeg", "description": "An angle in degrees." },
    "time": { "syntax": "numberms | numbers", "description": "A transition duration or delay." },
    "color": { "syntax": "named | transparent | #RGB | #RRGGBB | #AARRGGBB | 0xAARRGGBB | rgb() | rgba() | hsl() | hsla()", "description": "A HISE color, including alpha-first eight-digit formats." },
    "numeric-expression": { "syntax": "number-with-unit | calc() | min() | max() | clamp() | var()", "description": "A supported numeric expression." },
    "shadow": { "syntax": "[inset] length{2,4} color[, shadow]*", "description": "One or more comma-separated outer or inset shadows." },
    "transform-list": { "syntax": "none | transform-function+", "description": "A whitespace-separated list of supported 2D transforms." },
    "transition": { "syntax": "property time [timing] [delay]", "description": "One transition tuple; transition lists are unsupported." }
  },
  "globalValues": {
    "auto": "Context-dependent automatic value.",
    "initial": "Mapped to HISE's internal default or absent value.",
    "inherit": "Mapped to HISE's internal default or absent value, not standard inheritance semantics.",
    "unset": "Mapped to HISE's internal default or absent value.",
    "revert": "Unsupported CSS-wide cascade keyword.",
    "revert-layer": "Unsupported CSS-wide cascade keyword.",
    "important": "Raises declaration priority when used as the final separate !important token.",
    "var": "Substitutes a stylesheet variable without fallback syntax."
  },
