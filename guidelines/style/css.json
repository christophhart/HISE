    "align-self": { "category": "flex", "status": "partial", "description": "Overrides an item's cross-axis alignment.", "values": ["auto", "flex-start", "flex-end", "center", "stretch"] },
    "flex-grow": { "category": "flex", "status": "supported", "description": "Sets positive free-space growth.", "values": "<number>" },
    "flex-shrink": { "category": "flex", "status": "supported", "description": "Sets negative free-space shrink.", "values": "<number>" },
    "flex-basis": { "category": "flex", "status": "partial", "description": "Sets the initial flex size.", "values": "<numeric-expression>" },
    "order": { "category": "flex", "status": "supported", "description": "Sets flex item ordering.", "values": "<integer>" },
    "gap": { "category": "flex", "status": "partial", "description": "Adds spacing between flex children.", "values": "<length-percentage>", "deviation": "Emulated with synthetic half-margins and may differ at wrapping and reverse-flow edges." },
    "background": { "category": "background", "status": "partial", "description": "Sets a background color or linear gradient.", "values": "<color> | linear-gradient(...)" },
    "background-color": { "category": "background", "status": "partial", "description": "Sets the background brush color or gradient.", "values": "<color> | linear-gradient(...) | color-mix(...)" },
    "background-image": { "category": "background", "status": "partial", "description": "Sets one URL image, linear gradient, or HISE Path image.", "values": "url(...) | linear-gradient(...) | base64 JUCE Path", "deviation": "URL rendering can suppress normal fill, border, and box-shadow painting." },
    "background-size": { "category": "background", "status": "partial", "description": "Selects background or gradient sizing.", "values": ["fill", "contain", "cover", "none", "scale-down"], "deviation": "scale-down preserves natural size when the source fits; otherwise it uses contain scaling and never enlarges. background-position remains deferred." },
    "background-position": { "category": "background", "status": "partial", "description": "Sets a HISE background offset.", "values": "<numeric-expression>", "deviation": "Axis, keyword, percentage, and URL-image positioning are deferred; avoid for portable CSS." },
